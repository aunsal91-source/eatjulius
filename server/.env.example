DATABASE_URL=postgresql://user:pass@host:5432/eatjulius
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
KITCHEN_PIN=
# optional overrides
SLOT_CAPACITY=4
MIN_LEAD_MINUTES=10
KITCHEN_LEAD_MINUTES=3
HOLD_MINUTES=10
MAX_ITEMS_PER_ORDER=6
# Star CloudPRNT: set the printer's server URL to https://<host>/cloudprnt/<PRINTER_TOKEN>
